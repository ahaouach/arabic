# ============================================================
# SECURITY: Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.
# ============================================================

# PostgreSQL connection string
# For local development with Docker:
#   docker run --name aqacademy-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=aqacademy -p 5432:5432 -d postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aqacademy?schema=public

# Secret used to sign JWT tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=c5f26166315005e4da9799aa5dac0516967c34374f692df93d53e94e54d4e8afb15da8f4094f9b2895a02146cce3a06566c67dd649eb988466094ff9e0da5f5f

# Base URL of the application (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI API key — used by lib/audio.ts for TTS (Arabic pronunciation).
# If unset, audio generation is skipped; the lesson player still works
# but audio buttons make no sound. Run `npm run audio:generate` after
# setting this to pre-populate /public/audio for every seeded lesson.
OPENAI_API_KEY=sk-replace-with-your-openai-key

# SMTP credentials for contact form emails (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=no-reply@example.com
CONTACT_TO_EMAIL=admin@example.com
